# Required
BOT_TOKEN=123456789:replace_with_your_telegram_bot_token

# Database: use MongoDB or local SQLite. When using Railway, mount a Volume
# at /data and set DB_PATH=/data/quizbot.sqlite3 for persistent SQLite storage.
# MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=quiz_bot_db
DB_PATH=data/quizbot.sqlite3

# Optional AI paragraph interpretation (OpenAI-compatible chat-completions API)
# Works with OpenAI and compatible gateways such as OpenRouter / Groq.
# AI_API_KEY=your_api_key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional diagnostics
LOG_LEVEL=INFO
PORT=8080
